{
  "name": "@local/pomodoro-clock",
  "version": "1.0.7",
  "private": true,
  "description": "Floating Pomodoro focus clock: 25/5/15 phases, draggable dial, cycle counter, and settings.",
  "type": "module",
  "icon": "./icon.svg",
  "scripts": {
    "test": "node test/model.test.mjs && node test/tip.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "test/*.mjs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
